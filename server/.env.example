# Copy this file to .env and fill in real values. Never commit .env.

# Neon connection string (Neon dashboard -> Connect -> pooled connection)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me

# How long a login lasts before you must sign in again
JWT_EXPIRES_IN=30d

# Comma-separated origins allowed to call the API from a browser (your Vercel site)
CORS_ORIGINS=http://localhost:5173

PORT=4000
